# Settings for the APP (built into the website). Copy to .env.local for local testing.
# On GitHub Pages these are set for you by .github/workflows/deploy-pages.yml.

# Address of your photo checker (Cloudflare Worker), no trailing slash.
# Locally, `npm run checker:dev` runs it at http://localhost:8787
NEXT_PUBLIC_VERIFY_URL=http://localhost:8787

# Leave empty locally. GitHub Pages serves the site from /<repo-name>.
NEXT_PUBLIC_BASE_PATH=
